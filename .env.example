# Copy to .env.local for development, or set these as secrets when deploying.
# See DEPLOY.md.

# Shared organizer password. Without it the organizer screens stay closed.
MINI_LEAGUE_PASSWORD=change-me

# Signs the session cookie. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Without it a new key is made on every start and everyone is signed out.
MINI_LEAGUE_SECRET_KEY=change-me

# Where the SQLite file lives.
# MINI_LEAGUE_DATABASE_URL=sqlite:///mini_league.db

# Google Analytics. Unset means no analytics script is loaded at all, which is
# the default. Set it to your measurement id to turn it on.
# MINI_LEAGUE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Rating parameters, all optional. Replay ratings after changing any of them.
# MINI_LEAGUE_BETA=4.1667
# MINI_LEAGUE_TAU=0.0833
# MINI_LEAGUE_SIGMA=8.3333
# MINI_LEAGUE_W_VARIETY=0.3
